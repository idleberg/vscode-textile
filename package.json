{
    "name": "textile",
    "displayName": "Textile",
    "description": "Syntax highlighting and snippets for the Textile markup language",
    "version": "0.2.0",
    "publisher": "idleberg",
    "license": "MIT",
    "author": {
        "name": "Jan T. Sott",
        "url": "http://github.com/idleberg"
    },
    "scripts": {
        "precommit": "npm run test",
        "test": "vscode-linter",
        "vscode:prepublish": "gulp"
    },
    "keywords": [
        "textile"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/idleberg/vscode-textile"
    },
    "homepage": "https://github.com/idleberg/vscode-textile#readme",
    "bugs": {
        "url": "https://github.com/idleberg/vscode-textile/issues"
    },
    "icon": "images/logo.png",
    "galleryBanner": {
        "color": "#555555",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.0.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "contributes": {
        "languages": [
            {
                "id": "textile",
                "aliases": [
                    "Textile",
                    "textile"
                ],
                "extensions": [
                    ".textile"
                ],
                "configuration": "./config/textile.json"
            }
        ],
        "grammars": [
            {
                "language": "textile",
                "scopeName": "text.html.textile",
                "path": "./syntaxes/Textile.tmLanguage"
            }
        ],
        "snippets": [
            {
                "language": "textile",
                "path": "./snippets/textile.json"
            }
        ]
    },
    "devDependencies": {
        "gulp": "^4.0.2",
        "gulp-raster": "^0.2.0",
        "gulp-rename": "^2.0.0",
        "husky": "^4.3.0",
        "vscode": "^1.1.37",
        "vscode-linter": "^0.3.1"
    },
    "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
